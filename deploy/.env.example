# Copy to .env on the server and fill in.  Never commit the real .env.

# ---- LiveKit (self-hosted) ----
# Generate a key/secret pair:
#   docker run --rm livekit/livekit-server generate-keys
# The SAME key + secret must also go into livekit.yaml (keys:) — see DEPLOY.md.
# Do NOT set LIVEKIT_URL here; it is set per-service in docker-compose.app.yml.
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Speech + LLM providers (your existing keys) ----
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
GOOGLE_API_KEY=

GEMINI_MODEL=gemini-2.5-flash-lite
CHAT_MODEL=gemini-2.5-flash

# ---- Google Calendar ----
GOOGLE_CALENDAR_ID=
DEFAULT_TIMEZONE_OFFSET=330

# ---- App ----
PORT=8005
